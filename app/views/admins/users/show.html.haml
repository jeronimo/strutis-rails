%h1 User

%dl
  %dt ID
  %dd= @user.id
  %dt Email
  %dd= @user.email
  %dt Sign In Count
  %dd= @user.sign_in_count
  %dt Created At
  %dd= l(@user.created_at, format: :long)
  %dt Updated At
  %dd= l(@user.updated_at, format: :long)

%hr

= link_to 'Back', admins_users_path, class: 'btn btn-secondary'
= link_to 'Edit', edit_admins_user_path(@user), class: 'btn btn-primary'
= link_to 'Destroy', admins_user_path(@user), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-danger'
