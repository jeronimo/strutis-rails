%h5 User

%table.table
  %tbody
    %tr
      %td ID
      %td= @user.id
    %tr
      %td Email
      %td= @user.email
    %tr
      %td Authentication Token
      %td= @user.authentication_token
    %tr
      %td Sign In Count
      %td= @user.sign_in_count
    %tr
      %td Created At
      %td= l(@user.created_at, format: :long)
    %tr
      %td Updated At
      %td= l(@user.updated_at, format: :long)

= link_to 'Back', admins_users_path, class: 'btn btn-sm btn-secondary'
= link_to 'Edit', edit_admins_user_path(@user), class: 'btn btn-sm btn-primary'
= link_to 'Destroy', admins_user_path(@user), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-sm btn-danger'
