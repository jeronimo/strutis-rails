.container
  = render 'users/account_tabs', active_tab: 'profile'

  = form_with model: @user, url: users_profile_path, method: :patch do |f|
    - if @user.errors.any?
      .alert.alert-danger
        %h4= pluralize(@user.errors.count, 'error') + ' prohibited this profile from being saved:'
        %ul
          - @user.errors.full_messages.each do |message|
            %li= message

    = f.label :email, class: 'form-label mb-1'
    = f.email_field :email, class: 'form-control', readonly: true

    = f.label :full_name, class: 'form-label mb-1'
    = f.text_field :full_name, class: 'form-control', required: false

    = f.label :password, class: 'form-label mb-1'
    = f.password_field :password, class: 'form-control', placeholder: 'leave blank if you don\'t want to change it', required: false

    = f.label :password_confirmation, class: 'form-label mb-1'
    = f.password_field :password_confirmation, class: 'form-control', required: false

    .mt-2
      = f.submit 'Save', class: 'btn btn-sm btn-primary'
      = link_to 'Back', new_conversation_path, class: 'btn btn-sm btn-secondary'
