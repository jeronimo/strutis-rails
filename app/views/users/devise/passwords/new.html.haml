%h2.text-center.mb-4 Forgot your password?
= form_for(resource, as: resource_name, url: user_password_path, data: { turbo: false }) do |f|
  = render 'users/devise/shared/error_messages', resource: resource

  .mb-3
    = f.label :email, class: 'form-label'
    = f.email_field :email, autofocus: true, autocomplete: 'email', class: 'form-control'

  .d-grid
    = f.submit 'Send me password reset instructions', class: 'btn btn-primary'

= render 'users/devise/shared/links'
