%template#new-folder-form-template
  .p-2
    = form_with url: folders_path, method: :post, id: 'new-folder-form' do
      = hidden_field_tag :parent_id, nil, id: 'new-folder-parent-id'
      .mb-2
        = label_tag 'new-folder-name', 'Folder name', class: 'form-label'
        = text_field_tag :name, nil, id: 'new-folder-name', class: 'form-control form-control-sm', required: true
      .d-flex.justify-content-end.gap-2.mt-2
        %button.btn.btn-secondary.btn-sm{ type: 'button', id: 'new-folder-cancel' } Cancel
        %button.btn.btn-primary.btn-sm{ type: 'submit' } Add
