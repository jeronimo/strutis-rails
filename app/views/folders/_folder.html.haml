.folder.list-group-item{ id: dom_id(folder), data: { type: 'folder', id: folder.id, position: folder.position } }
  .folder-header.d-flex.align-items-center.gap-2{ data: { controller: 'folder-menu' } }
    %span.drag-handle{ 'aria-hidden': true }
      = render 'icons/grip'
    = link_to toggle_folder_path(folder, active_conversation_public_id: active_public_id), \
      class: 'folder-toggle text-muted text-decoration-none', data: { turbo_method: :patch }, 'aria-expanded': folder.collapsed? ? 'false' : 'true', 'aria-label': 'Toggle folder' do
      = render 'icons/chevron_down'
    %span.folder-name.fw-medium.flex-grow-1.text-truncate{ id: "folder-name-#{folder.id}", data: { folder_menu_target: 'name' } }= folder.name
    = form_with url: folder_path(folder), method: :patch, class: 'folder-rename-form d-none flex-grow-1', data: { folder_menu_target: 'form' } do
      = text_field_tag :name, folder.name, class: 'form-control form-control-sm', data: { folder_menu_target: 'input', action: 'keydown->folder-menu#handleKeydown blur->folder-menu#handleBlur' }
    .dropdown
      %button.btn.btn-sm.conversation-menu-toggle{ type: 'button', 'aria-label': 'Folder options', 'aria-expanded': 'false', data: { bs_toggle: 'dropdown', bs_auto_close: 'outside', folder_menu_target: 'toggle' } }
        = render 'icons/menu_dots'
      %ul.dropdown-menu.dropdown-menu-end
        %li
          = link_to new_conversation_path(folder_id: folder.id), class: 'dropdown-item d-flex align-items-center gap-2', data: { bs_dismiss: 'dropdown' } do
            = render 'icons/message_plus'
            New conversation
        %li
          %button.dropdown-item.d-flex.align-items-center.gap-2{ type: 'button', data: { new_folder_trigger: true, parent_id: folder.id } }
            = render 'icons/folder_plus'
            New subfolder
        %li
          %button.dropdown-item.d-flex.align-items-center.gap-2{ type: 'button', data: { action: 'folder-menu#rename', bs_dismiss: 'dropdown' } }
            = render 'icons/pencil'
            Rename
        %li
          = button_to folder_path(folder), method: :delete, class: 'dropdown-item conversation-delete d-flex align-items-center gap-2',
            form: { class: 'd-inline', data: { turbo_confirm: 'Delete this folder? Subfolders are deleted, conversations move to ungrouped.' } } do
            = render 'icons/trash'
            Delete
  .folder-children-collapse{ id: "folder-children-#{folder.id}", class: folder.collapsed? ? 'd-none' : nil }
    .list-group.list-group-flush.folder-children{ id: "conversation-items-#{folder.id}", data: { conversation_list_target: 'items', folder_id: folder.id } }
      - children.each do |node|
        = render_tree_item(node, active_public_id: active_public_id)
