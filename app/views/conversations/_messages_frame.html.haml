= turbo_frame_tag "messages-#{conversation.public_id}", data: { conversation_target: 'messages' } do
  %div{ id: "messages-list-#{conversation.public_id}" }
    - messages.each do |message|
      = render 'conversations/message', message: message
  = render 'conversations/progress', conversation: conversation, active: show_progress
  = render 'conversations/context_usage', conversation: conversation
  %div{ id: "conversation-frame-error-#{conversation.public_id}" }
    - if conversation.last_error.present?
      = render 'conversations/error', error: conversation.last_error
