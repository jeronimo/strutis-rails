:ruby
  messages = local_assigns[:messages] || []
  models = local_assigns[:models] || []
  current_model = local_assigns[:current_model]
  conversation = local_assigns[:conversation]
  public_id = conversation&.public_id

= turbo_frame_tag 'conversation_frame' do
  = turbo_frame_tag 'messages' do
    - messages.each do |message|
      = render 'conversations/message', role: message.role, content: message.content

  = form_with url: conversations_path, method: :post, data: { turbo_frame: '_self', controller: 'conversation' } do
    = hidden_field_tag :conversation_public_id, public_id, 'data-conversation-target': 'conversationId'
    .d-flex.flex-column.gap-2.my-3
      = text_area_tag :message, '',
        rows: 3,
        placeholder: 'Enter your message... (Press Enter to send)',
        class: 'form-control conversation-textarea',
        id: 'conversation-textarea',
        'data-conversation-target': 'textarea'
    .d-flex.align-items-center.gap-2
      = select_tag :model, options_for_select(models, current_model), class: 'form-select select-model-width', 'data-conversation-target': 'model'
      %small.text-muted{ 'data-conversation-target': 'label' }= public_id ? "Conversation: ##{public_id[0..7]}..." : ''
