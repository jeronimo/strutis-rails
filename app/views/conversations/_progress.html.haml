.chat-progress.mb-4{ id: "conversation-progress-#{conversation.public_id}" }
  .d-flex.align-items-center.gap-2
    .progress.flex-grow-1
      .progress-bar.w-50
    %a.btn.btn-outline-danger.btn-sm{ href: stop_conversation_path(conversation.public_id), 'data-turbo-method': 'post' }
      Stop
  %span.small.text-muted{ id: "conversation-progress-status-#{conversation.public_id}" }
