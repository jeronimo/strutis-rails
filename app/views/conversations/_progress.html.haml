.chat-progress.mb-4{ id: "conversation-progress-#{conversation.public_id}", class: [ ('d-none' unless active) ] }
  .d-flex.align-items-center.gap-2
    .progress.flex-grow-1
      .progress-bar.w-50
    %a.btn.btn-outline-danger.btn-sm{ href: stop_conversation_path(conversation.public_id), 'data-turbo-method': 'post' }
      Stop
  - if (status = local_assigns[:retry_status])
    %span.alert.alert-warning.py-2.mb-0.chat-retry-status{ data: { controller: 'retry-countdown', retry_countdown_seconds_value: status[:wait].to_i } }
      Retrying — attempt #{status[:attempt]} of #{status[:max]}, next try in
      %span{ data: { retry_countdown_target: 'count' } }= status[:wait]
      s
