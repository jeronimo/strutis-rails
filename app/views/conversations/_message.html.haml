- case message.role
- when 'compaction'
  = render 'conversations/compaction_message', message: message
- when 'tool'
  = render 'conversations/tool_message', message: message
- when 'user', 'assistant'
  - if message.content.present? || (message.role == 'assistant' && message.reasoning.present?)
    = render 'conversations/chat_message', message: message
