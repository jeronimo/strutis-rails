.chat-message.mb-3{ id: "message-#{message.id}", class: [ message.role == 'user' && 'chat-message-user', message.queued? && 'chat-message-queued' ].compact }
  - if message.queued?
    .small.text-muted.mb-1 Queued
  - if message.role == 'assistant' && message.reasoning.present?
    %details.chat-bubble.chat-tool{ id: "message-reasoning-#{message.id}" }
      %summary.small.text-muted
        thought
        - if message.inference_ms
          · #{format_ms(message.inference_ms)}
      %pre.small.mb-0
        = message.reasoning
  - if message.content.present? || message.attachments.any?
    .chat-bubble{ id: "message-content-#{message.id}", data: { final: message.latency_ms.present? } }
      - if message.content.present?
        = render_message_markdown(message.content)
      - if message.attachments.any?
        %ul.list-unstyled.mb-0
          - message.attachments.each do |attachment|
            %li= link_to attachment.filename.to_s, attachment.blob.url, target: '_blank', rel: 'noopener'
  - if message.role == 'assistant' && message.latency_ms && message.content.present?
    .chat-meta.small.text-muted
      = message_breakdown(message)
