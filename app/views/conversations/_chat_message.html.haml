.chat-message.mb-3{ id: "message-#{message.id}", class: message.role == 'user' ? 'chat-message-user' : nil }
  - if message.role == 'assistant' && message.reasoning.present?
    %details.chat-bubble.chat-tool{ id: "message-reasoning-#{message.id}" }
      %summary.small.text-muted
        thought
        - if message.inference_ms
          · #{format_ms(message.inference_ms)}
      %pre.small.mb-0
        = message.reasoning
  - if message.content.present?
    .chat-bubble{ id: "message-content-#{message.id}" }
      = render_message_markdown(message.content)
  - if message.role == 'assistant' && message.latency_ms && message.content.present?
    .chat-meta.small.text-muted
      = message_breakdown(message)
