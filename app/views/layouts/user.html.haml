!!!
%html
  %head
    %script{ async: true, src: 'https://www.googletagmanager.com/gtag/js?id=G-PJFNYWD3ZZ' }
    :javascript
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-PJFNYWD3ZZ');

    %title Strutis
    %meta{ name: 'viewport', content: 'width=device-width,initial-scale=1' }
    = csrf_meta_tags
    = csp_meta_tag
    = action_cable_meta_tag

    = yield :head

    = favicon_link_tag 'favicon-64x64.png'

    = stylesheet_link_tag 'bootstrap/bootstrap', 'data-turbo-track': 'reload'
    = stylesheet_link_tag 'bootstrap/custom'
    = stylesheet_link_tag 'application', 'data-turbo-track': 'reload'
    = isolated_importmap_tags 'application'

  %body{ data: { controller: 'conversation-drawer' } }
    .conversation-drawer-backdrop{ data: { conversation_drawer_target: 'backdrop', action: 'conversation-drawer#close' } }
    .container-fluid
      .row
        .col-md-3
          %nav.navflex.flex-column.py-3.conversation-drawer{ data: { conversation_drawer_target: 'drawer' } }
            %h5.text-muted.d-flex.align-items-center.gap-2.mb-3.ps-2
              = link_to root_path, class: 'd-flex align-items-center gap-2 text-decoration-none' do
                = image_tag 'logo.webp', alt: 'Strutis', class: 'strutis-logo'
                %span Strutis
            - if current_user
              .list-group#conversation-list
                .list-group-item.new-conversation-row.d-flex.align-items-center
                  = link_to new_conversation_path, id: 'new-conversation', class: 'flex-grow-1 d-flex align-items-center gap-2 text-decoration-none' do
                    = render 'icons/message_plus'
                    New Conversation
                  %button.btn.btn-sm.conversation-menu-toggle{ type: 'button', 'aria-label': 'New folder', data: { new_folder_trigger: true } }
                    = render 'icons/folder_plus'
                = render 'conversations/tree', conversations: @conversations, folders: @folders, active_public_id: @conversation&.public_id
              = render 'folders/new_folder_modal'
              .list-group.mt-2{ data: { turbo: false } }
                = link_to 'View all', conversations_path, class: 'list-group-item list-group-item-action'
                = link_to current_user.full_name.presence || current_user.email, edit_users_profile_path, class: 'list-group-item list-group-item-action'
                = button_to 'Sign Out', destroy_user_session_path, method: :delete, class: 'btn btn-link p-0 w-100 text-start text-decoration-none', form: { class: 'list-group-item list-group-item-action' }
            - else
              .list-group.mt-2
                = link_to 'Sign In', user_email_sign_in_path, class: 'list-group-item list-group-item-action'
        .col-md-9.d-flex.flex-column.gap-2.gap-md-0.mt-md-3
          .conversation-drawer-header.d-md-none.py-2.px-3
            = button_tag type: 'button', class: 'btn btn-outline-primary btn-sm', 'aria-label': 'Conversation list', 'aria-expanded': 'false',
              data: { conversation_drawer_target: 'toggle', action: 'conversation-drawer#toggle' } do
              %svg{ xmlns: 'http://www.w3.org/2000/svg', width: 16, height: 16, fill: 'currentColor', viewBox: '0 0 16 16', 'aria-hidden': true }
                %path{ d: 'M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-5a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-5a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5' }
            %span.conversation-drawer-title.flex-grow-1.text-truncate{ id: 'conversation-drawer-title' }= @conversation&.title.presence || 'New Conversation'
          .container
            = render_flash :user
          .d-flex.flex-column.flex-fill
            = yield
