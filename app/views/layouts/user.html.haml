!!!
%html
  %head
    %script{ async: true, src: 'https://www.googletagmanager.com/gtag/js?id=G-PJFNYWD3ZZ' }
    :javascript
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-PJFNYWD3ZZ');

    %title Strutis
    %meta{ name: 'viewport', content: 'width=device-width,initial-scale=1' }
    = csrf_meta_tags
    = csp_meta_tag

    = yield :head

    = stylesheet_link_tag 'bootstrap/bootstrap', 'data-turbo-track': 'reload'
    = stylesheet_link_tag 'bootstrap/custom'
    = stylesheet_link_tag 'application', 'data-turbo-track': 'reload'
    = isolated_importmap_tags 'application'

  %body
    .container-fluid
      .row
        .col-md-2
          %nav.navflex.flex-column.mt-3
            %h5.text-muted.d-flex.align-items-center.mb-4
              %span Strutis
            = link_to 'New Chat', new_chat_path, class: 'nav-link'
            %hr
              = button_to 'Sign Out', destroy_user_session_path, class: 'nav-link', method: :delete, form: { data: { turbo: false } }
        .col-md-10.mt-3
          = yield
