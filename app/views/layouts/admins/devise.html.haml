!!!
%html
  %head
    %title Strutis Admin
    %meta{ name: 'viewport', content: 'width=device-width,initial-scale=1' }
    = csrf_meta_tags
    = csp_meta_tag

    = stylesheet_link_tag 'bootstrap/bootstrap', 'data-turbo-track': 'reload'
    = stylesheet_link_tag 'bootstrap/custom'
    = stylesheet_link_tag :admin, 'data-turbo-track': 'reload'

  %body.d-flex.align-items-start.mt-3
    .container
      .row.justify-content-center
        .col-md-6.col-lg-4
          = yield
