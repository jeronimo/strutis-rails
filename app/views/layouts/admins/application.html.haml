!!!
%html
  %head
    %title Strutis Admin
    %meta{ name: 'viewport', content: 'width=device-width,initial-scale=1' }
    = csrf_meta_tags
    = csp_meta_tag

    = stylesheet_link_tag 'bootstrap/bootstrap', 'data-turbo-track': 'reload'
    = stylesheet_link_tag 'admin', 'data-turbo-track': 'reload'
    = isolated_importmap_tags 'admin'

  %body
    .container-fluid
      .row
        - if admin_signed_in?
          .col-md-2
            %nav.navflex.flex-column.mt-3
              %h5.text-muted.d-flex.align-items-center.mb-4
                %span Strutis Admin
              = link_to 'Dashboard', admins_root_path, class: 'nav-link'
              = link_to 'Users', admins_users_path, class: 'nav-link'
              %hr
              = link_to 'Sign out', destroy_admin_session_path, method: :delete, data: { turbo_method: :delete }, class: 'nav-link'
          .col-md-10.mt-3
            = render 'admins/partials/flash'
            = yield
        - else
          .col-md-12
            = render 'admins/partials/flash'
            = yield
