!!!
%html
  %head
    %title Strutis Admin
    %meta{ name: 'viewport', content: 'width=device-width,initial-scale=1' }
    = csrf_meta_tags
    = csp_meta_tag

    %link{
      href: 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css',
      rel: 'stylesheet', crossorigin: 'anonymous',
      integrity: 'sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB',
    }
    = stylesheet_link_tag 'admins', 'data-turbo-track': 'reload'
    = javascript_importmap_tags 'admins'

  %body
    .container-fluid
      .row
        - if admin_signed_in?
          .col-md-2
            %nav.navflex.flex-column.mt-3
              %h5.text-muted.d-flex.align-items-center.mb-4
                %span Strutis Admin
              = link_to 'Dashboard', admins_root_path, class: 'nav-link'
              = link_to 'Users', admins_users_path, class: 'nav-link'
              %hr
              = link_to 'Sign out', destroy_admin_session_path, method: :delete, data: { turbo_method: :delete }, class: 'nav-link'
          .col-md-10.mt-3
            = render 'admins/partials/flash'
            = yield
        - else
          .col-md-12
            = render 'admins/partials/flash'
            = yield

    %script{
      src: 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js',
      integrity: 'sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI',
      crossorigin: 'anonymous'
    }
