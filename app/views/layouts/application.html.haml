!!!
%html
  %head
    %script{ async: true, src: 'https://www.googletagmanager.com/gtag/js?id=G-PJFNYWD3ZZ' }
    :javascript
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-PJFNYWD3ZZ');

    %title= content_for(:title) || 'Strutis'
    %meta{ name: 'viewport', content: 'width=device-width,initial-scale=1' }
    %meta{ name: 'apple-mobile-web-app-capable', content: 'yes' }
    %meta{ name: 'application-name', content: 'Strutis' }
    %meta{ name: 'mobile-web-app-capable', content: 'yes' }
    = csrf_meta_tags
    = csp_meta_tag

    = yield :head

    = favicon_link_tag 'favicon-64x64.png'

    = stylesheet_link_tag 'bootstrap/bootstrap'
    = stylesheet_link_tag 'application', 'data-turbo-track': 'reload'
    = isolated_importmap_tags 'application'

  %body
    = yield
